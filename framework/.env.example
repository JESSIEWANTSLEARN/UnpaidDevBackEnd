APP_NAME=WalangBrownout
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# WalangBrownout uses MySQL locally and on Railway.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=walangbrownout
DB_USERNAME=root
DB_PASSWORD=

# Laravel session storage.
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Brevo is used for OTP/email delivery. Never commit the real key.
BREVO_API_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@walangbrownout.local"
MAIL_FROM_NAME="${APP_NAME}"

# OTP policy
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=2
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_COMPLETION_MINUTES=10
OTP_LOGIN_SUBJECT="WalangBrownout - Login Verification"
OTP_SIGNUP_SUBJECT="WalangBrownout - Account Verification"
OTP_PASSWORD_RESET_SUBJECT="WalangBrownout - Password Reset Code"

# Session security
SESSION_IDLE_SECONDS=60
SESSION_IDLE_WARNING_SECONDS=15
SUPER_ADMIN_IDLE_SECONDS=86400
TRACKED_SESSION_STALE_HOURS=24
TRACKED_SESSION_RETENTION_DAYS=90
TRACKED_SESSION_PAGE_SIZE=10

# Trusted devices
TRUSTED_DEVICE_DAYS=30
TRUSTED_DEVICE_COOKIE=wbo_trusted_device
TRUSTED_DEVICE_SECURE_COOKIE=
TRUSTED_DEVICE_SAME_SITE=lax

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
